---
import Base from '../layouts/Base.astro';
---
<Base judul="Halaman tidak ditemukan">
  <div class="halaman-kepala" style="padding-bottom:64px">
    <span class="label">404</span>
    <h1>Halaman ini tidak ketemu</h1>
    <p class="pengantar">Alamatnya mungkin salah ketik atau halamannya sudah dipindah. Coba mulai dari beranda.</p>
    <div class="aksi" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px">
      <a class="tombol" href="/">Ke beranda</a>
      <a class="tombol garis" href="/produk/">Lihat produk</a>
    </div>
  </div>
</Base>
